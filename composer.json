{
    "name": "roundly-consulting/shops-for-laravel",
    "description": "Manage single or multiple shops with products, categories, and orders in Laravel.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "shops",
        "ecommerce",
        "products",
        "orders"
    ],
    "homepage": "https://github.com/roundly-consulting/shops-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        { "type": "path", "url": "../media-library-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/media-library-for-laravel", "no-api": true },
        { "type": "path", "url": "../reviews-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/reviews-for-laravel", "no-api": true },
        { "type": "path", "url": "../attributes-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/attributes-for-laravel", "no-api": true },
        { "type": "path", "url": "../coupons-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/coupons-for-laravel", "no-api": true },
        { "type": "path", "url": "../credits-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/credits-for-laravel", "no-api": true },
        { "type": "path", "url": "../addresses-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/addresses-for-laravel", "no-api": true }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/addresses-for-laravel": "@dev",
        "roundly-consulting/attributes-for-laravel": "@dev",
        "roundly-consulting/coupons-for-laravel": "@dev",
        "roundly-consulting/credits-for-laravel": "@dev",
        "roundly-consulting/media-library-for-laravel": "@dev",
        "roundly-consulting/reviews-for-laravel": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Shops\\": "src/",
            "RoundlyConsulting\\Shops\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Shops\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Shops\\ShopsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
